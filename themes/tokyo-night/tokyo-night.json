{
  "$schema": "https://raw.githubusercontent.com/grimoire-codex/community-add-ons/main/schema/theme.schema.json",
  "id": "tokyo-night",
  "name": "Tokyo Night",
  "version": "1.0.0",
  "mode": "dark",
  "app_mode": "grimoire",
  "author": "folke",
  "description": "A clean, dark Neovim & VS Code theme inspired by the lights of Tokyo at night.",
  "homepage": "https://github.com/folke/tokyonight.nvim",
  "variants": {
    "dark": {
      "bg-deep": "#1a1b26",
      "bg-panel": "#16161e",
      "bg-card": "#24283b",
      "bg-card-hover": "#2f354f",
      "bg-input": "#16161e",
      "border": "#414868",
      "border-light": "#565f89",
      "accent": "#7aa2f7",
      "accent-dim": "#5a84db",
      "accent-bright": "#9ab8ff",
      "accent-alt": "#bb9af7",
      "on-accent": "#15161e",
      "text": "#c0caf5",
      "text-dim": "#a9b1d6",
      "text-muted": "#565f89",
      "red": "#f7768e",
      "green": "#9ece6a",
      "blue": "#7aa2f7",
      "danger": "#f7768e",
      "danger-fill": "#f7768e",
      "on-danger": "#15161e",
      "warning": "#e0af68",
      "success": "#9ece6a",
      "on-media": "#ffffff",
      "on-media-border": "rgba(255, 255, 255, 0.4)",
      "tag-bg": "#24283b",
      "tag-border": "#414868",
      "mark-bg": "rgba(224, 175, 104, 0.35)",
      "invite-bg": "rgba(122, 162, 247, 0.2)",
      "overlay": "rgba(22, 22, 30, 0.85)",
      "shadow": "rgba(0, 0, 0, 0.5)",
      "scrim": "rgba(0, 0, 0, 0.6)",
      "scrim-strong": "rgba(0, 0, 0, 0.8)",
      "type-book": "#bb9af7",
      "type-map": "#7dcfff",
      "type-token": "#9ece6a",
      "type-audio": "#e0af68",
      "type-file": "#7aa2f7",
      "variant": "#f7768e"
    }
