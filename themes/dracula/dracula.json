{
  "$schema": "https://raw.githubusercontent.com/grimoire-codex/community-add-ons/main/schema/theme.schema.json",
  "id": "dracula",
  "name": "Dracula",
  "version": "1.0.0",
  "mode": "dark",
  "app_mode": "grimoire",
  "author": "zenorocha",
