  "homepage": "https://draculatheme.com",
  "variants": {
    "dark": {
      "bg-deep": "#282a36",
      "bg-panel": "#21222c",
      "bg-card": "#282a36",
      "bg-card-hover": "#44475a",
      "bg-input": "#21222c",
      "border": "#6272a4",
      "border-light": "#44475a",
      "accent": "#bd93f9",
      "accent-dim": "#9867db",
      "accent-bright": "#d6acff",
      "accent-alt": "#ff79c6",
      "on-accent": "#282a36",
      "text": "#f8f8f2",
      "text-dim": "#e2e2dc",
      "text-muted": "#6272a4",
      "red": "#ff5555",
      "green": "#50fa7b",
