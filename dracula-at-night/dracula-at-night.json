  "variants": {
    "dark": {
      "bg-deep": "#0e1419",
      "bg-panel": "#0a0e12",
      "bg-card": "#11171d",
      "bg-card-hover": "#1d2730",
      "bg-input": "#0a0e12",
      "border": "#354556",
      "border-light": "#44576c",
      "accent": "#bd93f9",
      "accent-dim": "#9867db",
      "accent-bright": "#d6acff",
      "accent-alt": "#ff79c6",
      "on-accent": "#0e1419",
